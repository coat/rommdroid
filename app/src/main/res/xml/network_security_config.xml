<?xml version="1.0" encoding="utf-8"?>
<!--
  RomM is self-hosted, and the address of the server is whatever the user typed
  on the setup screen: a LAN IP, an mDNS name, a Tailscale address, a hostname
  from their own DNS.  Nothing here can enumerate that set ahead of time — and
  <domain> could not express it anyway, being a hostname suffix matcher with no
  notion of a subnet.  Listing "192.168.0.0/16" only ever matched a host
  literally named that, which is why a plain http://192.168.0.2 was refused
  while http://romm.local (a suffix match on "local") went through.

  So cleartext is permitted outright.  The alternative is refusing to talk to
  the server most users actually run, and TLS is not something a box on the
  living-room LAN generally has.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
